<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubControlMAUI.Pages.SliderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SubControlMAUI.ViewModels"
    x:DataType="vm:SliderViewModel"
    Title="{Binding Title}"
Shell.NavBarIsVisible="False">




    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Padding="10">

            <!-- CUSTOM TITLE BAR -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,*"
                  Margin="0,0,0,10">

                <Button Grid.Column="1"
                        Text="⬅ Back"
                        FontSize="18"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Command="{Binding GoBackCommand}" />

                <Label Grid.Column="0"
                       Text="{Binding Title}"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"
                       VerticalOptions="Center" />

                <!-- Empty right column to keep title centred -->
                <Label Grid.Column="2" />

            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="1"
                    StrokeThickness="0"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="Status:"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Margin="10,0,0,0"
                           Text="{Binding StatusText}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                </Grid>
            </Border>


            <Grid Grid.Row="2"
                  ColumnDefinitions="*,2*,*">
                <Button Grid.Column="0"
                        Text="Send Test Message"
                        FontSize="20"
                        HeightRequest="80"
                        Command="{Binding SendSliderMessageCommand}"
                        BorderWidth="0" />
                <Border Grid.Column="1"
                        StrokeThickness="2"
                        Stroke="{AppThemeBinding Light=Black, Dark=White}"
                        StrokeShape="RoundRectangle 20"
                        Padding="40"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="CVAL"
                               FontSize="20"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Message}"
                               FontSize="48"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Label Grid.Column="3"
                        Text="{Binding SliderReceivedMessage}"
                        FontSize="20"
                        HeightRequest="80" />
            </Grid>







            
            
        </Grid>
    </Grid>

</ContentPage>