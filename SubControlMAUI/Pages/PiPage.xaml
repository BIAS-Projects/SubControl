<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SubControlMAUI.ViewModels"
             x:Class="SubControlMAUI.Pages.PiPage"
             x:DataType="vm:PiViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="8"
          Padding="12">

        <!-- ROW 0 – Title bar (fixed) -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="Back"
                    Command="{Binding GoBackCommand}" />

            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   FontAttributes="Bold"
                   VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Text" Value="Connected" />
                        <Setter Property="TextColor" Value="Green" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="False">
                        <Setter Property="Text" Value="Disconnected" />
                        <Setter Property="TextColor" Value="Red" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>

        <!-- ROW 1 – Scrollable content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">

                <!-- CONNECTION -->
                <Border Stroke="Gray"
        StrokeThickness="1"
        Padding="10">
                    <Grid RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,*,Auto,*,Auto"
          ColumnSpacing="8"
          RowSpacing="8">

                        <Label Grid.Row="0" Grid.Column="0"
               Text="Host:"
               VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1"
               Text="{Binding Host}"
               FontFamily="Courier New"
               VerticalOptions="Center" />

                        <Label Grid.Row="1" Grid.Column="0"
               Text="User:"
               VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1"
               Text="{Binding UserName}"
               IsEnabled="{Binding IsNotConnected}" />

                        <Label Grid.Row="1" Grid.Column="2"
               Text="Password:"
               VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="3"
               Text="{Binding Password}"
               IsPassword="True"
               IsEnabled="{Binding IsNotConnected}" />

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="4"
                               Spacing="6">
                            <Button Text="Connect"
                    Command="{Binding ConnectCommand}" />
                            <Button Text="Disconnect"
                    Command="{Binding DisconnectCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- MediaMTX Deployment -->
                <Border Stroke="Gray"
                        StrokeThickness="1"
                        Padding="10">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="MediaMTX Deployment"
                               FontAttributes="Bold"
                               FontSize="15" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Placeholder="Select mediamtx_vX.X.X_linux_arm64.tar.gz"
                                   Text="{Binding MediaMtxLocalPath}"
                                   IsReadOnly="True"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Button Grid.Column="1"
                                    Text="Browse"
                                    Command="{Binding PickMediaMtxFileCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Install dir:" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding MediaMtxInstallDir}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Label Grid.Column="2" Text="Run as:" VerticalOptions="Center" />
                            <Entry Grid.Column="3"
                                   Text="{Binding MediaMtxServiceUser}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Deploy"
                                    Command="{Binding DeployMediaMtxCommand}" />

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <ProgressBar x:Name="DeployProgressBar"
                                             HeightRequest="8" />
                                <Label Text="{Binding DeployStatus}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       IsVisible="{Binding IsDeploying}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- FFmpeg Deployment -->
                <Border Stroke="Gray"
                        StrokeThickness="1"
                        Padding="10">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="FFmpeg Deployment"
                               FontAttributes="Bold"
                               FontSize="15" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Placeholder="Select ffmpeg-release-arm64-static.tar.gz / .tar.xz"
                                   Text="{Binding FfmpegLocalPath}"
                                   IsReadOnly="True"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Button Grid.Column="1"
                                    Text="Browse"
                                    Command="{Binding PickFfmpegFileCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Install dir:" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding FfmpegInstallDir}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Label Grid.Column="2" Text="Run as:" VerticalOptions="Center" />
                            <Entry Grid.Column="3"
                                   Text="{Binding FfmpegServiceUser}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Deploy"
                                    Command="{Binding DeployFfmpegCommand}" />

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <ProgressBar Progress="{Binding FfmpegDeployProgressConverted}"
                                             HeightRequest="8" />
                                <Label Text="{Binding FfmpegDeployStatus}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       IsVisible="{Binding IsFfmpegDeploying}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- .NET App Deployment -->
                <Border Stroke="Gray"
                        StrokeThickness="1"
                        Padding="10">
                    <VerticalStackLayout Spacing="8">

                        <Label Text=".NET App Deployment"
                               FontAttributes="Bold"
                               FontSize="15" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Placeholder="Select Local Publish Output Folder"
                                   Text="{Binding DotNetLocalPath}"
                                   IsReadOnly="True"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Button Grid.Column="1"
                                    Text="Browse"
                                    Command="{Binding PickDotNetFolderCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Install dir:" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding DotNetInstallDir}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Label Grid.Column="2" Text="Exe Name:" VerticalOptions="Center" />
                            <Entry Grid.Column="3"
                                   Text="{Binding DotNetExecutableName}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                            <Label Grid.Column="4" Text="Service ID:" VerticalOptions="Center" />
                            <Entry Grid.Column="5"
                                   Text="{Binding DotNetServiceName}"
                                   FontFamily="Courier New"
                                   FontSize="12" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Deploy App"
                                    Command="{Binding DeployDotNetAppCommand}" />

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <ProgressBar Progress="{Binding DotNetDeployProgressConverted}"
                                             HeightRequest="8" />
                                <Label Text="{Binding DotNetDeployStatus}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       IsVisible="{Binding IsDotNetDeploying}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- UART / Bluetooth Configuration -->
                <Border Stroke="Gray"
                        StrokeThickness="1"
                        Padding="10">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="UART Configuration"
                               FontAttributes="Bold"
                               FontSize="15" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Configure UART &amp; Reboot"
                                    Command="{Binding ConfigureUartAndRebootCommand}"
                                    IsEnabled="{Binding IsConnected}" />

                            <Label Grid.Column="1"
                                   Text="{Binding UartConfigStatus}"
                                   FontSize="11"
                                   TextColor="Gray"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Terminal output: single read-only, auto-growing Editor
                     (same pattern as LogsPage's tail output) so multi-line
                     output can be drag-selected and copied at once. -->
                <Label Text="Terminal Output"
                       FontAttributes="Bold"
                       FontSize="13"
                       TextColor="Gray" />

                <Border Stroke="Gray"
                        StrokeThickness="1"
                        Padding="6"
                        HeightRequest="320">
                    <ScrollView x:Name="TerminalScrollView">
                        <Editor x:Name="TerminalOutputEditor"
                                Text="{Binding TerminalOutput, Mode=OneWay}"
                                FontFamily="Courier New"
                                FontSize="12"
                                IsReadOnly="True"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent"
                                Placeholder="No output yet. Connect to get started."
                                HorizontalOptions="Fill" />
                    </ScrollView>
                </Border>

                <!-- Toolbar -->
                <Button Text="Clear"
                        Command="{Binding ClearTerminalCommand}"
                        HorizontalOptions="Start" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
